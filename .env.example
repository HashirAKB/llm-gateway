# Copy to .env and fill in as needed. Everything is optional: with no values
# the gateway runs fully offline against the mock provider.

# Real upstream. When set, routes listing provider "anthropic" become active.
ANTHROPIC_API_KEY=

# Port the gateway listens on.
PORT=8080

# Path to the gateway config (keys, routes, prices, limits).
GATEWAY_CONFIG=config/gateway.json

# Share rate limits across instances via Redis, e.g. redis://localhost:6379
REDIS_URL=

# Tracing: send spans to an OTLP/HTTP collector (e.g. Jaeger on :4318), or print them.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_CONSOLE=false
OTEL_SERVICE_NAME=llm-gateway
