{
  "name": "llm-gateway",
  "version": "0.1.0",
  "description": "Self-hostable LLM gateway: routing, resilience, rate limits, caching, cost metering, guardrails and observability.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.5",
    "autocannon": "^8.0.0",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
